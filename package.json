{
  "name": "arcmoq",
  "version": "1.0.0",
  "private": true,
  "description": "ArcMOQ — UAE SME group purchasing with AI procurement and Arc testnet settlement",
  "workspaces": [
    "contracts",
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "install:all": "npm install",
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "compile": "npm run compile -w contracts",
    "deploy": "npm run deploy -w contracts",
    "seed": "npm run seed -w backend",
    "demo": "npm run demo -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
